# Security Headers for Production
/*
  # XSS Protection
  X-XSS-Protection: 1; mode=block
  
  # Content Type Options
  X-Content-Type-Options: nosniff
  
  # Frame Options
  X-Frame-Options: DENY
  
  # Referrer Policy
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissions Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  
  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  
  # HSTS (Strict Transport Security)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Cache Control for HTML files
  Cache-Control: public, max-age=3600

# Cache static assets for better performance
/lovable-uploads/*
  Cache-Control: public, max-age=31536000, immutable
  
/university-logos/*
  Cache-Control: public, max-age=31536000, immutable
  
/highschool-logos/*
  Cache-Control: public, max-age=31536000, immutable
  
/contacts/*
  Cache-Control: public, max-age=31536000, immutable

# SEO and indexing files
/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=3600
  
/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=3600

# API endpoints with stricter CSP
/api/*
  Content-Security-Policy: default-src 'none'; connect-src 'self';